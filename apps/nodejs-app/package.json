{
  "name": "multicloud-nodejs-app",
  "version": "1.0.0",
  "description": "Sample Node.js application for multi-cloud deployment",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "build": "echo 'No build step required for Node.js'",
    "docker:build": "docker build -t multicloud-nodejs-app .",
    "docker:run": "docker run -p 3000:3000 multicloud-nodejs-app"
  },
  "keywords": [
    "nodejs",
    "multicloud",
    "kubernetes"
  ],
  "author": "MultiCloud Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
